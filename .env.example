# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored — never commit real credentials.

# Which DB backend the server uses: sqlite (default, no Docker needed) or postgres
DB_BACKEND=postgres

# WebSocket port the server listens on (default 8765)
SERVER_PORT=8765

# PostgreSQL connection — must match the postgres service in docker-compose.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=kungfu
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kungfu_chess

# Redis connection — must match the redis service in docker-compose.yml
REDIS_HOST=redis
REDIS_PORT=6379
